{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "miniprogram/config/**/*.ts",
    "miniprogram/session/**/*.ts",
    "miniprogram/storage/key-value.ts",
    "miniprogram/http/client.ts",
    "miniprogram/navigation/auth-navigation.ts",
    "miniprogram/navigation/startup.ts",
    "miniprogram/services/auth.ts",
    "miniprogram/services/account.ts",
    "miniprogram/account/**/*.ts",
    "miniprogram/ledger/**/*.ts",
    "miniprogram/services/ledger.ts",
    "miniprogram/services/category.ts",
    "miniprogram/services/tag.ts",
    "miniprogram/services/transaction.ts",
    "miniprogram/transaction/**/*.ts",
    "miniprogram/category/**/*.ts",
    "miniprogram/tag/**/*.ts"
  ]
}
