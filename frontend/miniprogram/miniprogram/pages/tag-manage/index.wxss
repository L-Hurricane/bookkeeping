.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.row.selected {
  border: 1rpx solid #111111;
}

.meta,
.hint,
.status,
.label {
  color: #888888;
  font-size: 24rpx;
}

.label,
.field,
.error,
.confirm {
  display: block;
  margin-top: 16rpx;
}

.field {
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.error,
.confirm {
  color: #b42318;
}

.actions {
  margin-top: 28rpx;
}

.danger {
  color: #b42318;
}
