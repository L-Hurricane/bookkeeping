<view class="page" wx:if="{{phase === 'loading'}}">
  <text class="status">正在读取标签</text>
</view>
<view class="page" wx:elif="{{phase === 'error'}}">
  <text class="error">{{errorMessage}}</text>
  <button bindtap="reload">重新加载</button>
</view>
<view class="page" wx:else>
  <view class="row {{selectedId === item.id ? 'selected' : ''}}" wx:for="{{rows}}" wx:key="id" style="margin-left: {{(item.depth - 1) * 28}}rpx;">
    <view class="row-main" data-id="{{item.id}}" bindtap="onSelect">
      <text class="name">{{item.name}}</text>
      <text class="meta">{{item.hasChildren ? '有下级' : '可关联'}}</text>
    </view>
    <text class="handle" data-id="{{item.id}}" catchtouchstart="onHandleStart" catchtouchmove="onHandleMove" catchtouchend="onHandleEnd">⋮⋮</text>
  </view>
  <view class="composer" wx:if="{{composer}}">
    <input class="field" type="text" maxlength="100" placeholder="标签名称" value="{{name}}" disabled="{{submitting}}" bindinput="onName" />
    <picker mode="selector" range="{{parentLabels}}" value="{{parentIndex}}" disabled="{{submitting}}" bindchange="onParent">
      <view class="field">上级 {{parentLabels[parentIndex]}}</view>
    </picker>
    <button disabled="{{submitting}}" bindtap="onCreate">创建</button>
  </view>
  <view class="add" wx:else bindtap="onOpenComposer">+ 新增标签</view>
  <text class="error" wx:if="{{errorMessage}}">{{errorMessage}}</text>
  <text class="confirm" wx:if="{{confirm}}">{{confirm}}</text>
  <view class="mask" wx:if="{{parentSheet}}" catchtouchmove="onHold">
    <view class="backdrop" bindtap="onCloseSheet"></view>
    <view class="sheet">
      <text class="sheet-title">选择新的上级</text>
      <scroll-view scroll-y class="sheet-list">
        <view class="choice" wx:for="{{moveLabels}}" wx:key="*this" data-index="{{index}}" bindtap="onChooseMove">{{item}}</view>
      </scroll-view>
      <view class="sheet-actions">
        <text bindtap="onRenamePrompt">改名</text>
        <text class="danger" bindtap="onDelete">{{confirm ? '确认删除' : '删除'}}</text>
        <text bindtap="onCloseSheet">关闭</text>
      </view>
    </view>
  </view>
</view>
