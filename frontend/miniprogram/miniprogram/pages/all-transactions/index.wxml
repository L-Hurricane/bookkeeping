<view class="page">
  <text class="status" wx:if="{{phase === 'loading' && rows.length === 0}}">正在读取交易</text>
  <block wx:elif="{{phase === 'error' && rows.length === 0}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
  </block>
  <block wx:else>
    <view class="month" wx:if="{{mode === 'month' && !searching}}">
      <text class="month-step" bindtap="onPreviousMonth">‹</text>
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-step" bindtap="onNextMonth">›</text>
    </view>
    <text class="range" wx:elif="{{label}}">{{label}}</text>
    <input class="search" value="{{searchInput}}" placeholder="搜索交易名称" bindinput="onSearchInput" confirm-type="search" />
    <text class="note">转账和余额调整不计入收入、支出。这里不显示逐笔余额。</text>
    <view class="summary" wx:if="{{summaryReady}}">
      <text>收入 <text class="{{incomeTone}}">{{incomeLabel}}</text></text>
      <text>支出 <text class="{{expenseTone}}">{{expenseLabel}}</text></text>
      <text>结余 <text class="{{surplusTone}}">{{surplusLabel}}</text></text>
    </view>
    <text class="empty" wx:if="{{rows.length === 0 && phase === 'ready'}}">没有交易</text>
    <view class="row" wx:for="{{rows}}" wx:key="key" data-index="{{index}}" bindtap="onOpen">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-detail">{{item.accountName}} · {{item.timeLabel}}</text>
      </view>
      <text class="amount {{item.tone}}">{{item.amountLabel}}</text>
    </view>
    <text class="error" wx:if="{{errorMessage && rows.length > 0}}">{{errorMessage}}</text>
    <button wx:if="{{hasMore}}" bindtap="onMore">加载更多</button>
  </block>
  <view class="fab" wx:if="{{fabAccounts.length > 0}}">
    <view class="fab-accounts" wx:if="{{fabPicking}}">
      <view class="fab-account" wx:for="{{fabAccounts}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickAccount">{{item.name}}</view>
    </view>
    <view class="fab-menu" wx:if="{{fabOpen}}">
      <text bindtap="onFabExpense">支出</text>
      <text bindtap="onFabIncome">收入</text>
      <text bindtap="onFabTransfer">转账</text>
    </view>
    <text class="fab-button" bindtap="onToggleFab">记</text>
  </view>
</view>
