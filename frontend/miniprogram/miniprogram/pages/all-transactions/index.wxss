.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 220rpx;
  box-sizing: border-box;
}

.month,
.summary {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.note,
.range,
.row-detail,
.empty {
  display: block;
  color: #666666;
  font-size: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.search {
  margin: 16rpx 0;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.error {
  color: #c23a2b;
}

.money-positive { color: #c23a2b; }
.money-negative { color: #1f7a4c; }
.money-zero { color: #333333; }
