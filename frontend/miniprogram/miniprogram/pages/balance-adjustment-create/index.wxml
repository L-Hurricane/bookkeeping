<view class="page" wx:if="{{screen === 'invalid'}}">
  <text class="error">余额调整页面参数无效</text>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{screen === 'loading'}}">
  <text class="hint">正在读取当前余额</text>
</view>
<view class="page" wx:elif="{{screen === 'error'}}">
  <text class="error">当前余额读取失败，请重新加载</text>
  <button bindtap="onRetryBalance">重新加载</button>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{screen === 'ready'}}">
  <text class="label">当前余额</text>
  <text class="balance">{{currentBalanceLabel}}</text>
  <text class="label">目标余额</text>
  <input class="amount" type="text" value="{{target}}" disabled="{{formLocked}}" bindinput="onTarget" />
  <text class="error" wx:if="{{targetError}}">{{targetError}}</text>
  <text class="label">{{previewCaption}}</text>
  <text class="preview">{{previewAmount}}</text>
  <text class="hint" wx:if="{{zeroMessage}}">{{zeroMessage}}</text>
  <text class="label">调整后余额</text>
  <text>{{afterLabel}}</text>
  <text class="label">记录时间</text>
  <view class="choice {{formLocked ? 'locked' : ''}}" bindtap="onOpenTime">{{businessTimeText}} ></view>
  <text class="error" wx:if="{{timeError}}">{{timeError}}</text>
  <text class="hint" wx:if="{{futureHint}}">{{futureHint}}</text>
  <text class="label">备注</text>
  <input class="field" type="text" value="{{remark}}" disabled="{{formLocked}}" bindinput="onRemark" />
  <text class="error" wx:if="{{submitError}}">{{submitError}}</text>
  <text class="hint" wx:if="{{uncertain}}">请重试确认。同一保存请求不会创建第二笔余额调整。</text>
  <button wx:if="{{uncertain}}" bindtap="onRetrySave">重试确认</button>
  <view class="actions">
    <button class="cancel" bindtap="onCancel">取消</button>
    <button class="save" disabled="{{saveDisabled}}" bindtap="onSave">保存调整</button>
  </view>
  <view class="mask" wx:if="{{timeEditorOpen}}" catchtouchmove="onHold">
    <view class="backdrop" bindtap="onCancelTime"></view>
    <view class="panel">
      <text class="editor-title">编辑记录时间</text>
      <text class="label">日期</text>
      <input class="field" type="text" placeholder="YYYY-MM-DD" value="{{timeDate}}" disabled="{{formLocked}}" bindinput="onTimeDate" />
      <text class="label">时间</text>
      <input class="field" type="text" placeholder="HH:mm:ss" value="{{timeClock}}" disabled="{{formLocked}}" bindinput="onTimeClock" />
      <view class="shortcuts {{formLocked ? 'locked' : ''}}">
        <text class="shortcut" bindtap="onTimeNow">现在</text>
        <text class="shortcut" bindtap="onTimeToday">今天</text>
        <text class="shortcut" bindtap="onTimeYesterday">昨天</text>
      </view>
      <text class="error" wx:if="{{timeDraftError}}">{{timeDraftError}}</text>
      <view class="editor-actions">
        <button bindtap="onCancelTime">取消</button>
        <button class="save" bindtap="onConfirmTime">确定</button>
      </view>
    </view>
  </view>
</view>
