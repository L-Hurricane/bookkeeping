.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f3f4f6;
}

.card {
  margin-bottom: 20rpx;
  padding: 8rpx 24rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.locked-type,
.amount {
  display: block;
}

.amount-label {
  display: block;
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: 650;
}

.delete-link {
  display: block;
  margin-top: 28rpx;
  color: #b42318;
  text-align: center;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.type-label,
.label,
.hint,
.placeholder {
  color: #666666;
  font-size: 26rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.amount {
  font-size: 56rpx;
  font-weight: 600;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.fact {
  margin-top: 28rpx;
}

.fact .label {
  display: block;
  margin-bottom: 6rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
}

.chip.selected {
  background: #111111;
  color: #ffffff;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.edit {
  background: #111111;
  color: #ffffff;
}

.delete {
  background: #ffffff;
  color: #b42318;
}

.field,
.choice {
  margin-top: 8rpx;
}

.field {
  width: 100%;
}

.datetime-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.datetime-input {
  flex: 1;
  margin-top: 0;
}

.datetime-picker {
  flex-shrink: 0;
}

.picker-link {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
  color: #111111;
  font-size: 26rpx;
}

.locked {
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.4);
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.account-list {
  max-height: 52vh;
}

.account-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-copy {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.account-name {
  font-size: 32rpx;
}

.account-kind,
.account-mark,
.sheet-group {
  color: #888888;
  font-size: 24rpx;
}

.sheet-group {
  display: block;
  margin-top: 16rpx;
}

.account-balance {
  font-size: 30rpx;
  font-weight: 600;
}

.group {
  display: block;
  margin-top: 20rpx;
  color: #666666;
}

.child {
  padding-left: 24rpx;
}

.editor-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.shortcuts,
.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.shortcut {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
}

.error {
  color: #b42318;
  font-size: 26rpx;
}

.save {
  background: #1f4b73;
  color: #ffffff;
}

.cancel {
  background: #f3f3f3;
  color: #111111;
}
