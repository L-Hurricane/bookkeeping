.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.type-label,
.label,
.hint,
.placeholder {
  color: #666666;
  font-size: 26rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.amount {
  font-size: 56rpx;
  font-weight: 600;
}

.fact {
  margin-top: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
}

.chip.selected {
  background: #111111;
  color: #ffffff;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.edit {
  background: #111111;
  color: #ffffff;
}

.delete {
  background: #ffffff;
  color: #b42318;
}

.field,
.choice {
  margin-top: 8rpx;
}

.field {
  width: 100%;
}

.datetime-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.datetime-input {
  flex: 1;
  margin-top: 0;
}

.datetime-picker {
  flex-shrink: 0;
}

.picker-link {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
  color: #111111;
  font-size: 26rpx;
}

.locked {
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.4);
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.panel-list {
  height: 56vh;
}

.group {
  display: block;
  margin-top: 20rpx;
  color: #666666;
}

.child {
  padding-left: 24rpx;
}

.editor-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.shortcuts,
.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.shortcut {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
}

.error {
  color: #b42318;
  font-size: 26rpx;
}

.save {
  background: #111111;
  color: #ffffff;
}

.cancel {
  background: #f3f3f3;
  color: #111111;
}
