.line {
  width: 100%;
  height: 280rpx;
  margin-top: 12rpx;
}

.trend {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 96rpx;
  margin: 16rpx 0;
}

.trend-bar {
  flex: 1;
  min-width: 4rpx;
  background: #3d5a80;
}

.ring {
  width: 280rpx;
  height: 280rpx;
  margin: 16rpx auto;
}

.bar-track {
  height: 8rpx;
  margin-top: 8rpx;
  background: #eeeeee;
}

.bar-fill {
  height: 8rpx;
  background: #3d5a80;
}

.bar-fill.picked {
  background: #1a1a1a;
}

.row.picked {
  background: #f4f6f8;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.panel {
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.date-value {
  color: #1f4b73;
  font-weight: 600;
}

.panel-title {
  display: block;
  margin-bottom: 16rpx;
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
}

.figure {
  font-size: 34rpx;
  font-weight: 600;
}

.ring-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin: 8rpx auto 0;
}

.ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.money-neutral {
  color: #333333;
}

.quiet {
  margin-top: 20rpx;
  background: #f3f4f6;
  color: #1a1a1a;
  font-size: 28rpx;
}

.multi {
  margin-top: 8rpx;
  color: #3d5a80;
  font-size: 24rpx;
}

.choices,
.month,
.types {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.types {
  margin-top: 24rpx;
  justify-content: flex-start;
  gap: 24rpx;
}

.month-step,
.month-label {
  font-size: 32rpx;
}

.month-label,
.section,
.row-title {
  font-weight: 600;
}

.type {
  color: #666666;
  font-size: 30rpx;
}

.type.selected {
  color: #111111;
  font-weight: 600;
}

.summary {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
}

.summary-item,
.row-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.label,
.status,
.count,
.row-detail,
.note,
.empty {
  color: #666666;
  font-size: 26rpx;
}

.section {
  display: block;
  margin-top: 36rpx;
  font-size: 30rpx;
}

.note,
.empty,
.status,
.count {
  display: block;
  margin-top: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.row.depth-1 {
  padding-left: 32rpx;
}

.row.depth-2 {
  padding-left: 64rpx;
}

.choice {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #666666;
  font-size: 26rpx;
}

.choice.selected {
  background: #ffffff;
  border: 1rpx solid #1a1a1a;
  color: #1a1a1a;
  font-weight: 600;
}

.range {
  display: block;
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.amount {
  font-size: 30rpx;
}

.error {
  color: #b42318;
}

.analysis-entry {
  margin-top: 24rpx;
  background: transparent;
  color: #111111;
  font-size: 28rpx;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(26, 26, 26, 0.28);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-list {
  height: 640rpx;
}

.sheet-tools,
.sheet-actions,
.group-head,
.pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-tools,
.group-head {
  margin: 16rpx 0;
  color: #1a1a1a;
  font-size: 28rpx;
}

.pick {
  padding: 22rpx 0;
  border-top: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.search {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
}
