.page {
  min-height: 100vh;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.title {
  display: block;
  margin-bottom: 48rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.field {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
}

.error {
  display: block;
  margin-bottom: 24rpx;
  color: #b42318;
}

.submit {
  margin-top: 8rpx;
}
