<view class="page">
  <text class="title">个人记账</text>
  <input class="field" placeholder="用户名" value="{{username}}" bindinput="onUsernameInput" />
  <input class="field" password placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
  <text class="error" wx:if="{{errorMessage}}">{{errorMessage}}</text>
  <button class="submit" disabled="{{submitting}}" bindtap="onSubmit">登录</button>
</view>
