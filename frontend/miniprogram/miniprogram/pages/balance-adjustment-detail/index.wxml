<view class="page" wx:if="{{screen === 'invalid'}}">
  <text class="error">余额调整页面参数无效</text>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{screen === 'loading'}}">
  <text class="hint">正在读取余额调整</text>
</view>
<view class="page" wx:elif="{{screen === 'error'}}">
  <text class="error">余额调整读取失败，请重新加载</text>
  <button bindtap="onRetry">重新加载</button>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{screen === 'missing'}}">
  <text class="error">余额调整不存在或已删除</text>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{screen === 'delete-uncertain'}}">
  <text class="error">删除结果尚未确认</text>
  <text class="hint">请重试确认。重复删除不会创建另一笔记录。</text>
  <text class="hint" wx:if="{{deleteHint}}">{{deleteHint}}</text>
  <button disabled="{{deleteLocked}}" bindtap="onRetryDelete">重试确认</button>
  <button disabled="{{deleteLocked}}" bindtap="onBack">返回</button>
</view>
<view class="page" wx:else>
  <text class="label">调整金额</text>
  <text class="amount">{{amountLabel}}</text>
  <text class="label">记录时间</text>
  <text>{{businessTimeLabel}}</text>
  <text class="label">备注</text>
  <text>{{remarkLabel}}</text>
  <text class="hint">余额调整属于独立记录类型，不计入收支统计；已保存后不可编辑，如需变更请删除后重建。</text>
  <text class="error" wx:if="{{actionError}}">{{actionError}}</text>
  <text class="hint" wx:if="{{deleteHint}}">{{deleteHint}}</text>
  <text class="hint" wx:if="{{readOnly}}">{{archiveHint}}</text>
  <button wx:if="{{readOnly}}" bindtap="onOpenSettings">账户设置</button>
  <button wx:else class="delete" disabled="{{deleteLocked}}" bindtap="onDelete">删除余额调整</button>
</view>
