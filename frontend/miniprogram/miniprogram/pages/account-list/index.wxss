.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-bottom: 20rpx;
}

.tool {
  color: #1f4b73;
  font-size: 28rpx;
}

.board {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.board-label {
  display: block;
  color: #666666;
  font-size: 24rpx;
}

.board-net {
  display: block;
  margin: 8rpx 0 28rpx;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}

.board-split {
  display: flex;
  gap: 24rpx;
}

.board-cell {
  flex: 1;
}

.board-amount {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.money-neutral {
  color: #333333;
}

.card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.card.member {
  transition: transform 160ms ease;
}

.dragging {
  transition: none;
  z-index: 2;
}

.card-main,
.card-side {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-side {
  align-items: flex-end;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
}

.card-kind,
.status,
.empty,
.card-hint {
  color: #666666;
  font-size: 24rpx;
}

.card-balance {
  font-size: 36rpx;
  font-weight: 600;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.error {
  color: #b42318;
}

.section {
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.section-subtotal,
.handle {
  font-size: 28rpx;
}

.handle {
  padding: 8rpx 16rpx;
  color: #1f4b73;
  letter-spacing: -2rpx;
}

.dragging {
  position: relative;
  z-index: 2;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.12);
  transition: none;
}

.member {
  margin-left: 24rpx;
}
