.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.link {
  flex: 1;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
}

.toolbar-hint {
  display: block;
  margin-bottom: 20rpx;
  color: #888888;
  font-size: 24rpx;
}

.card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-main,
.card-side {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-side {
  align-items: flex-end;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
}

.card-kind,
.status,
.empty,
.card-hint {
  color: #666666;
  font-size: 24rpx;
}

.card-balance {
  font-size: 36rpx;
  font-weight: 600;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.error {
  color: #b42318;
}

.logout {
  margin-top: 32rpx;
  background: transparent;
  color: #666666;
}
