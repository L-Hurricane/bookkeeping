.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-bottom: 20rpx;
}

.tool {
  color: #1f4b73;
  font-size: 28rpx;
}

.board {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.board-label {
  display: block;
  color: #666666;
  font-size: 24rpx;
}

.board-net {
  display: block;
  margin: 8rpx 0 28rpx;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}

.board-split {
  display: flex;
  gap: 24rpx;
}

.board-cell {
  flex: 1;
}

.board-amount {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.money-neutral {
  color: #333333;
}

.card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-main,
.card-side {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-side {
  align-items: flex-end;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
}

.card-kind,
.status,
.empty,
.card-hint {
  color: #666666;
  font-size: 24rpx;
}

.card-balance {
  font-size: 36rpx;
  font-weight: 600;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.error {
  color: #b42318;
}
