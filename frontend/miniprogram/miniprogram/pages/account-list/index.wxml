<view class="page">
  <text class="status" wx:if="{{phase === 'loading'}}">正在读取账户</text>
  <block wx:elif="{{phase === 'error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
  </block>
  <block wx:else>
    <view class="toolbar">
      <text class="tool" bindtap="onOpenGroups">管理分组</text>
      <text class="tool" wx:if="{{grouped}}" bindtap="onToggleSort">{{sorting ? '完成排序' : '排序'}}</text>
      <text class="tool" bindtap="onCreateAccount">创建账户</text>
      <text class="tool" bindtap="onOpenArchive">归档账户</text>
      <text class="tool" bindtap="onOpenAll">全部交易</text>
    </view>
    <view class="board" wx:if="{{summaryReady}}">
      <text class="board-label">本月账本净值</text>
      <text class="board-net {{netTone}}">{{netLabel}}</text>
      <view class="board-split">
        <view class="board-cell">
          <text class="board-label">本月收入</text>
          <text class="board-amount money-neutral">{{incomeLabel}}</text>
        </view>
        <view class="board-cell">
          <text class="board-label">本月支出</text>
          <text class="board-amount money-neutral">{{expenseLabel}}</text>
        </view>
      </view>
    </view>
    <text class="error" wx:if="{{summaryError}}">{{summaryError}}</text>
    <text class="error" wx:if="{{refreshError}}">{{refreshError}}</text>
    <button wx:if="{{refreshError}}" bindtap="onRetry">重新加载</button>
    <text class="empty" wx:if="{{!grouped && rows.length === 0 && hasArchived}}">没有正常账户</text>
    <block wx:if="{{!grouped}}">
      <view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenAccount">
        <view class="card-main">
          <text class="card-name">{{item.name}}</text>
          <text class="card-kind">{{item.kindLabel}}</text>
        </view>
        <text class="card-balance {{item.balanceToneClass}}">{{item.balanceLabel}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="section drop-target" wx:for="{{sections}}" wx:key="key" data-key="{{item.key}}">
        <view class="section-head {{sorting && draggingKey === 'group:' + item.groupId ? 'dragging' : ''}}" data-key="{{item.key}}" bindtap="onToggleSection" style="{{sorting && draggingKey === 'group:' + item.groupId ? 'transform: translateY(' + dragOffset + 'px);' : 'transform: translateY(' + item.shiftPx + 'px);'}}">
          <text class="section-title">{{item.expanded ? '▾' : '▸'}} {{item.title}}</text>
          <text class="section-subtotal" wx:if="{{item.showSubtotal}}">{{item.subtotalLabel}}</text>
          <text wx:if="{{sorting && item.groupId}}" class="handle" data-kind="group" data-id="{{item.groupId}}" data-section="{{item.key}}" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd">⋮⋮</text>
        </view>
        <block wx:if="{{item.expanded}}">
          <view class="card member {{sorting && draggingKey === 'account:' + account.id ? 'dragging' : ''}}" wx:for="{{item.accounts}}" wx:for-item="account" wx:key="id" data-id="{{account.id}}" bindtap="onOpenAccount" style="{{sorting && draggingKey === 'account:' + account.id ? 'transform: translateY(' + dragOffset + 'px);' : 'transform: translateY(' + account.shiftPx + 'px);'}}">
            <view class="card-main">
              <text class="card-name">{{account.name}}</text>
              <text class="card-kind">{{account.kindLabel}}</text>
            </view>
            <view class="card-side">
              <text class="card-balance {{account.balanceToneClass}}">{{account.balanceLabel}}</text>
              <text wx:if="{{sorting}}" class="handle" data-kind="account" data-id="{{account.id}}" data-section="{{item.key}}" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd">⋮⋮</text>
            </view>
          </view>
          <text class="empty" wx:if="{{item.accounts.length === 0}}">组内暂无正常账户</text>
        </block>
      </view>
    </block>
  </block>
  <entry-fab wx:if="{{rows.length > 0 && !loggingOut}}" above-tab="{{true}}" open="{{fabOpen}}" bind:toggle="onToggleFab" bind:expense="onFabExpense" bind:income="onFabIncome" bind:transfer="onFabTransfer" />
</view>
