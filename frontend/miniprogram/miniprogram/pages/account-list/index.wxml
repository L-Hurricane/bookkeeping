<view class="page">
  <text class="status" wx:if="{{phase === 'loading'}}">正在读取账户</text>
  <block wx:elif="{{phase === 'error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
  </block>
  <block wx:else>
    <view class="toolbar">
      <button class="link" disabled="{{loggingOut}}" bindtap="onOpenStatistics">统计</button>
      <button class="link" disabled="{{loggingOut}}" bindtap="onCreateAccount">创建账户</button>
      <button class="link" disabled="{{loggingOut}}" bindtap="onOpenArchive">归档账户</button>
    </view>
    <text class="toolbar-hint">正常账户总览。归档账户不在此列表，可从归档账户查看历史并恢复。</text>
    <text class="error" wx:if="{{refreshError}}">{{refreshError}}</text>
    <button wx:if="{{refreshError}}" bindtap="onRetry">重新加载</button>
    <text class="empty" wx:if="{{rows.length === 0 && hasArchived}}">正常账户列表是空的。归档账户仍保留余额和历史。</text>
    <view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenAccount">
      <view class="card-main">
        <text class="card-name">{{item.name}}</text>
        <text class="card-kind">{{item.kindLabel}}</text>
      </view>
      <view class="card-side">
        <text class="card-balance {{item.balanceToneClass}}">{{item.balanceLabel}}</text>
        <text class="card-hint" wx:if="{{item.negativeHint}}">{{item.negativeHint}}</text>
      </view>
    </view>
  </block>
  <text class="error" wx:if="{{logoutErrorMessage}}">{{logoutErrorMessage}}</text>
  <button class="logout" disabled="{{loggingOut}}" bindtap="onLogout">退出登录</button>
</view>
