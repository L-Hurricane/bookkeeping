.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.label,
.status,
.empty,
.card-kind {
  display: block;
  color: #666666;
  font-size: 26rpx;
}

.field {
  margin: 12rpx 0 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.handle {
  color: #1f4b73;
}

.error {
  display: block;
  margin-top: 24rpx;
  color: #b42318;
}
