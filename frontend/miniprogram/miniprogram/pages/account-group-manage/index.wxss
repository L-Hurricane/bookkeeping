.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.label,
.status,
.empty,
.card-kind {
  display: block;
  color: #666666;
  font-size: 26rpx;
}

.field {
  margin: 12rpx 0 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.dragging {
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.12);
  transition: none;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.handle {
  color: #1f4b73;
  letter-spacing: -2rpx;
}

.error {
  display: block;
  margin-top: 24rpx;
  color: #b42318;
}
