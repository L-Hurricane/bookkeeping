<view class="page" wx:if="{{phase === 'invalid'}}">
  <text class="error">账户设置参数无效</text>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:elif="{{phase === 'loading'}}">
  <text class="status">正在读取账户</text>
</view>
<view class="page" wx:elif="{{phase === 'error'}}">
  <text class="error">{{errorMessage}}</text>
  <button bindtap="onRetry">重新加载</button>
  <button bindtap="onBack">返回</button>
</view>
<view class="page" wx:else>
  <text class="label">账户类型</text>
  <text class="value">{{kindLabel}}</text>
  <text class="label">账户名称</text>
  <input class="field" type="text" maxlength="64" value="{{name}}" disabled="{{submitting}}" bindinput="onNameInput" />
  <text class="hint">更名不影响已有交易与余额。</text>
  <text class="error" wx:if="{{errorMessage}}">{{errorMessage}}</text>
  <view class="actions">
    <button class="cancel" disabled="{{submitting}}" bindtap="onBack">取消</button>
    <button class="save" disabled="{{submitting}}" bindtap="onSave">保存名称</button>
  </view>
</view>
