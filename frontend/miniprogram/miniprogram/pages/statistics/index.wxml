<view class="page">
  <view class="group">
    <view class="entry" data-view="net" bindtap="onOpenReport">
      <text class="entry-title">净值趋势</text>
      <text class="entry-go">></text>
    </view>
    <view class="entry" data-view="income-category" bindtap="onOpenReport">
      <text class="entry-title">收入分类对比</text>
      <text class="entry-go">></text>
    </view>
    <view class="entry" data-view="income-tag" bindtap="onOpenReport">
      <text class="entry-title">收入标签对比</text>
      <text class="entry-go">></text>
    </view>
    <view class="entry" data-view="expense-category" bindtap="onOpenReport">
      <text class="entry-title">支出分类对比</text>
      <text class="entry-go">></text>
    </view>
    <view class="entry" data-view="expense-tag" bindtap="onOpenReport">
      <text class="entry-title">支出标签对比</text>
      <text class="entry-go">></text>
    </view>
  </view>
  <view class="group analysis">
    <view class="entry" wx:if="{{showAnalysis}}" bindtap="onOpenAnalysis">
      <text class="entry-title">AI 分析本月</text>
      <text class="entry-go">></text>
    </view>
    <view class="entry" wx:else bindtap="onOpenLedgerAnalysis">
      <text class="entry-title">AI 分析</text>
      <text class="entry-go">></text>
    </view>
  </view>
</view>
