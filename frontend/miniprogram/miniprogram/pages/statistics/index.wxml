<view class="page">
  <view class="choices">
    <text class="choice {{preset === 'MONTH' ? 'selected' : ''}}" data-preset="MONTH" bindtap="onSelectPreset">本月</text>
    <text class="choice {{preset === 'QUARTER' ? 'selected' : ''}}" data-preset="QUARTER" bindtap="onSelectPreset">本季度</text>
    <text class="choice {{preset === 'YEAR' ? 'selected' : ''}}" data-preset="YEAR" bindtap="onSelectPreset">本年</text>
    <text class="choice {{preset === 'CUSTOM' ? 'selected' : ''}}" data-preset="CUSTOM" bindtap="onSelectPreset">自定义</text>
  </view>
  <view class="choices" wx:if="{{preset === 'CUSTOM'}}">
    <picker mode="date" value="{{customFrom}}" bindchange="onCustomFrom">
      <text class="choice">开始 {{customFrom}}</text>
    </picker>
    <picker mode="date" value="{{customTo}}" bindchange="onCustomTo">
      <text class="choice">结束 {{customTo}}</text>
    </picker>
  </view>
  <view class="choices">
    <text class="choice {{scope === 'ACTIVE' ? 'selected' : ''}}" data-scope="ACTIVE" bindtap="onSelectScope">正常账户</text>
    <text class="choice {{scope === 'ALL' ? 'selected' : ''}}" data-scope="ALL" bindtap="onSelectScope">全部账户</text>
    <text class="choice {{scope === 'SELECTED' ? 'selected' : ''}}" data-scope="SELECTED" bindtap="onSelectScope">自选</text>
  </view>
  <view wx:if="{{scope === 'SELECTED'}}">
    <view class="choice {{item.checked ? 'selected' : ''}}" wx:for="{{picker}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleAccount">
      {{item.name}}{{item.archived ? ' · 已归档' : ''}}
    </view>
  </view>
  <text class="range" wx:if="{{rangeLabel}}">{{rangeLabel}}</text>
  <button wx:if="{{showAnalysis}}" class="analysis-entry" bindtap="onOpenAnalysis">AI 分析本月</button>
  <view class="choices">
    <text class="choice {{module === 'NET' ? 'selected' : ''}}" data-module="NET" bindtap="onSelectModule">净资产</text>
    <text class="choice {{module === 'EXPENSE' ? 'selected' : ''}}" data-module="EXPENSE" bindtap="onSelectModule">支出</text>
    <text class="choice {{module === 'INCOME' ? 'selected' : ''}}" data-module="INCOME" bindtap="onSelectModule">收入</text>
  </view>
  <text class="status" wx:if="{{phase === 'loading'}}">正在读取统计</text>
  <text class="status" wx:elif="{{phase === 'choose'}}">{{errorMessage}}</text>
  <block wx:elif="{{phase === 'error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
  </block>
  <block wx:elif="{{phase === 'ready' && module === 'NET'}}">
    <text class="note">历史时点净资产按业务时间计算，不是包含未来记录的当前账面余额。</text>
    <view class="summary">
      <view class="summary-item">
        <text class="label">期初</text>
        <text class="{{openingTone}}">{{openingLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">期末</text>
        <text class="{{closingTone}}">{{closingLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">变动</text>
        <text class="{{changeTone}}">{{changeLabel}}</text>
      </view>
    </view>
    <text class="section">趋势</text>
    <view class="row" wx:for="{{points}}" wx:key="date">
      <text class="row-title">{{item.date}}</text>
      <text class="amount {{item.tone}}">{{item.amountLabel}}</text>
    </view>
  </block>
  <block wx:elif="{{phase === 'ready'}}">
    <text class="section {{netTone}}">合计 {{netLabel}}</text>
    <text class="empty" wx:if="{{emptyFlow}}">这个范围没有{{module === 'INCOME' ? '收入' : '支出'}}</text>
    <text class="section">分类</text>
    <view class="row depth-{{item.depth}}" wx:for="{{categories}}" wx:key="key" data-drill="{{item.drillKind}}" data-id="{{item.drillId}}" data-title="{{item.title}}" bindtap="onOpenRow">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-detail">{{item.detail}}</text>
      </view>
      <text class="amount {{item.amountToneClass}}">{{item.amountLabel}}</text>
    </view>
    <text class="section">标签</text>
    <text class="note">标签按当前标签树汇总，可以重叠，占比分母是全部收入或支出净额。</text>
    <button wx:if="{{selectedTagCount > 0}}" bindtap="onOpenSelectedTags">查看所选标签</button>
    <view class="row depth-{{item.depth}}" wx:for="{{tags}}" wx:key="key" data-drill="{{item.drillKind}}" data-id="{{item.drillId}}" data-title="{{item.title}}" bindtap="onOpenRow">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-detail">{{item.detail}}</text>
        <text wx:if="{{item.drillKind === 'tag'}}" catchtap="onToggleTag" data-id="{{item.drillId}}">{{item.selected ? '取消多选' : '加入多选'}}</text>
      </view>
      <text class="amount {{item.amountToneClass}}">{{item.amountLabel}}</text>
    </view>
  </block>
</view>
