.trend {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 96rpx;
  margin: 16rpx 0;
}

.trend-bar {
  flex: 1;
  min-width: 4rpx;
  background: #3d5a80;
}

.ring {
  width: 280rpx;
  height: 280rpx;
  margin: 16rpx auto;
}

.bar-track {
  height: 8rpx;
  margin-top: 8rpx;
  background: #eeeeee;
}

.bar-fill {
  height: 8rpx;
  background: #3d5a80;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.choices,
.month,
.types {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.types {
  margin-top: 24rpx;
  justify-content: flex-start;
  gap: 24rpx;
}

.month-step,
.month-label {
  font-size: 32rpx;
}

.month-label,
.section,
.row-title {
  font-weight: 600;
}

.type {
  color: #666666;
  font-size: 30rpx;
}

.type.selected {
  color: #111111;
  font-weight: 600;
}

.summary {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
}

.summary-item,
.row-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.label,
.status,
.count,
.row-detail,
.note,
.empty {
  color: #666666;
  font-size: 26rpx;
}

.section {
  display: block;
  margin-top: 36rpx;
  font-size: 30rpx;
}

.note,
.empty,
.status,
.count {
  display: block;
  margin-top: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.row.depth-1 {
  padding-left: 32rpx;
}

.row.depth-2 {
  padding-left: 64rpx;
}

.choice {
  color: #666666;
  font-size: 28rpx;
}

.choice.selected {
  color: #111111;
  font-weight: 600;
}

.range {
  display: block;
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.amount {
  font-size: 30rpx;
}

.error {
  color: #b42318;
}

.analysis-entry {
  margin-top: 24rpx;
  background: transparent;
  color: #111111;
  font-size: 28rpx;
}
