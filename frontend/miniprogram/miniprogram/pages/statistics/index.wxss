.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.group {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.entry:last-child {
  border-bottom: 0;
}

.entry-title {
  font-size: 32rpx;
  color: #1a1a1a;
}

.entry-go {
  color: #8a8a8a;
  font-size: 28rpx;
}

.analysis {
  margin-top: 12rpx;
}
