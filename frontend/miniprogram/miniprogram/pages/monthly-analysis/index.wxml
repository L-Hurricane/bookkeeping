<view class="page">
  <block wx:if="{{invalid}}">
    <text class="error">{{errorMessage}}</text>
  </block>
  <block wx:else>
    <view wx:if="{{ledgerMode}}" class="month">
      <text class="month-step" data-kind="MONTH" bindtap="onSelectLedgerKind">自然月</text>
      <text class="month-step" data-kind="YEAR" bindtap="onSelectLedgerKind">自然年</text>
    </view>
    <text wx:if="{{quotaNotice}}" class="notice">{{quotaNotice}}</text>
    <view class="month">
      <text class="month-step" bindtap="onPreviousMonth">‹</text>
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-step" bindtap="onNextMonth">›</text>
    </view>
    <text class="status" wx:if="{{phase === 'loading'}}">正在读取分析</text>
    <block wx:elif="{{phase === 'error'}}">
      <text class="error">{{errorMessage}}</text>
      <button class="retry" bindtap="onRetry">重新加载</button>
    </block>
    <block wx:elif="{{phase === 'ready'}}">
      <view class="facts">
        <text class="fact" wx:for="{{facts}}" wx:key="label">{{item.label}} {{item.text}}</text>
      </view>
      <text class="notice" wx:if="{{notice}}">{{notice}}</text>
      <text class="status" wx:if="{{submitting}}">正在提交分析</text>
      <text class="notice" wx:elif="{{actionMessage}}">{{actionMessage}}</text>
      <button wx:if="{{needsRefresh}}" class="generate" bindtap="onRetry">重新加载</button>
      <button wx:elif="{{canRefreshStatus}}" class="generate" bindtap="onRetry">刷新分析状态</button>
      <button wx:elif="{{canGenerate}}" class="generate" bindtap="onGenerate">生成分析</button>
      <block wx:for="{{sections}}" wx:key="title">
        <text class="section">{{item.title}}</text>
        <text class="section-body">{{item.text}}</text>
      </block>
      <text class="notice" wx:if="{{aiCaution}}">{{aiCaution}}</text>
    </block>
  </block>
</view>
