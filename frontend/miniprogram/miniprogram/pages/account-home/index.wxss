.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
}

.label,
.status {
  color: #666666;
}

.balance {
  font-size: 48rpx;
}

.error {
  color: #b42318;
}

.logout {
  margin-top: 24rpx;
}
