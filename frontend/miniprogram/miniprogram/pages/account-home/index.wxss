.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.asset,
.summary,
.row,
.search {
  background: #ffffff;
  border-radius: 20rpx;
}

.asset {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.asset .name,
.asset .kind,
.asset .label,
.asset .balance {
  display: block;
  max-width: 100%;
}

.asset .balance {
  font-size: 52rpx;
  line-height: 1.2;
  word-break: break-all;
}

.asset-links,
.day {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.asset-links {
  width: 100%;
  margin-top: 8rpx;
}

.day {
  margin: 20rpx 8rpx 8rpx;
  color: #666666;
  font-size: 24rpx;
}

.figure {
  font-size: 30rpx;
  font-weight: 600;
}

.nav {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.nav-link {
  color: #666666;
  font-size: 28rpx;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
}

.kind,
.hint {
  color: #888888;
  font-size: 24rpx;
}

.label,
.status,
.count,
.row-detail,
.row-time {
  color: #666666;
  font-size: 26rpx;
}

.balance {
  font-size: 56rpx;
  font-weight: 600;
}

.money-positive {
  color: #c23a2b;
}

.money-negative {
  color: #1f7a4c;
}

.money-zero {
  color: #333333;
}

.search {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ececec;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.month {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-step {
  width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: #333333;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
}

.summary {
  display: flex;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 20rpx 16rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.count,
.empty,
.status {
  margin-top: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.row.post-save-highlight {
  background: #f6f3ea;
}

.locate-miss {
  display: block;
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.row-main,
.row-side {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row-side {
  align-items: flex-end;
}

.row-title,
.amount {
  font-size: 30rpx;
}

.type.adjustment {
  color: #8a4b08;
}

.error {
  color: #b42318;
}

.statistics {
  margin-top: 8rpx;
  background: transparent;
  color: #666666;
  font-size: 28rpx;
}

.adjust {
  margin-top: 12rpx;
  background: transparent;
  color: #666666;
  font-size: 28rpx;
}

.transfer {
  margin-top: 12rpx;
  background: #f0f0f0;
  color: #111111;
}

.type.transfer {
  color: #245bdb;
}

.create {
  margin-top: 12rpx;
  background: #111111;
  color: #ffffff;
}

.logout {
  margin-top: 32rpx;
  background: transparent;
  color: #666666;
}
