<view class="page">
  <text class="status" wx:if="{{phase === 'account-loading'}}">正在读取账户</text>
  <block wx:elif="{{phase === 'account-error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
  </block>
  <block wx:else>
    <view class="header">
      <text class="name">{{name}}</text>
      <text class="label">当前余额</text>
      <text class="balance">{{balanceLabel}}</text>
      <button class="adjust" disabled="{{loggingOut}}" bindtap="onAdjust">余额调整</button>
      <button class="create" disabled="{{loggingOut}}" bindtap="onCreate">记一笔</button>
    </view>
    <view class="month">
      <text class="month-step" bindtap="onPreviousMonth">‹</text>
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-step" bindtap="onNextMonth">›</text>
    </view>
    <input class="search" value="{{searchInput}}" placeholder="搜索交易名称" bindinput="onSearchInput" confirm-type="search" />
    <button class="statistics" disabled="{{loggingOut}}" bindtap="onStatistics">统计</button>
    <view class="summary" wx:if="{{phase === 'ready'}}">
      <view class="summary-item">
        <text class="label">收入</text>
        <text>{{incomeLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">支出</text>
        <text>{{expenseLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">结余</text>
        <text>{{surplusLabel}}</text>
      </view>
    </view>
    <text class="count" wx:if="{{phase === 'ready'}}">{{countLabel}}</text>
    <text class="status" wx:if="{{phase === 'ledger-loading'}}">正在读取流水</text>
    <block wx:elif="{{phase === 'ledger-error'}}">
      <text class="error">{{errorMessage}}</text>
      <button bindtap="onRetry">重新加载</button>
    </block>
    <block wx:elif="{{phase === 'ready'}}">
      <text class="error" wx:if="{{searchErrorMessage}}">{{searchErrorMessage}}</text>
      <button wx:if="{{searchErrorMessage}}" bindtap="onRetry">重新搜索</button>
      <text class="status" wx:if="{{searchLoading}}">正在搜索</text>
      <text class="locate-miss" wx:if="{{locateMiss}}">{{locateMiss}}</text>
      <text class="empty" wx:if="{{searchEmpty}}">没有匹配的交易</text>
      <text class="empty" wx:elif="{{empty}}">本月暂无记录</text>
      <view id="{{item.key}}" class="row {{item.kind}} {{highlightKey === item.key ? 'post-save-highlight' : ''}}" wx:for="{{rows}}" wx:key="key" data-kind="{{item.kind}}" data-id="{{item.recordId}}" bindtap="onOpenRecord">
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
          <text class="row-time">{{item.timeLabel}}</text>
        </view>
        <view class="row-side">
          <text class="type {{item.kind}}">{{item.typeLabel}}</text>
          <text class="amount">{{item.amountLabel}}</text>
        </view>
      </view>
    </block>
  </block>
  <text class="error" wx:if="{{logoutErrorMessage}}">{{logoutErrorMessage}}</text>
  <button class="logout" disabled="{{loggingOut}}" bindtap="onLogout">退出登录</button>
</view>
