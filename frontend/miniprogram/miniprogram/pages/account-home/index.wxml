<view class="page">
  <text class="status" wx:if="{{phase === 'account-loading'}}">正在读取账户</text>
  <block wx:elif="{{phase === 'account-error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
    <button bindtap="onBackToList">返回账本</button>
  </block>
  <block wx:else>
    <view class="nav">
      <text class="nav-link" bindtap="onBackToList">‹ 账本</text>
      <text class="nav-link" bindtap="onOpenSettings">账户设置</text>
    </view>
    <view class="asset">
      <text class="name">{{name}}</text>
      <text class="kind">{{kindLabel}}</text>
      <text class="label">当前余额</text>
      <text class="balance {{balanceToneClass}}">{{balanceLabel}}</text>
      <text class="hint" wx:if="{{archiveHint}}">{{archiveHint}}</text>
      <view class="asset-links">
        <text class="nav-link" wx:if="{{!archived}}" bindtap="onAdjust">余额调整</text>
        <text class="nav-link" bindtap="onStatistics">统计</text>
      </view>
    </view>
    <view class="month">
      <text class="month-step" bindtap="onPreviousMonth">‹</text>
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-step" bindtap="onNextMonth">›</text>
    </view>
    <view class="summary" wx:if="{{phase === 'ready'}}">
      <view class="summary-item">
        <text class="label">收入</text>
        <text class="figure {{incomeToneClass}}">{{incomeLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">支出</text>
        <text class="figure {{expenseToneClass}}">{{expenseLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">{{monthCloseCaption || '结余'}}</text>
        <text class="figure {{monthCloseLabel ? monthCloseTone : surplusToneClass}}">{{monthCloseLabel || surplusLabel}}</text>
      </view>
    </view>
    <input class="search" value="{{searchInput}}" placeholder="搜索交易名称" bindinput="onSearchInput" confirm-type="search" />
    <entry-fab wx:if="{{!archived && phase !== 'account-loading' && phase !== 'account-error'}}" open="{{fabOpen}}" bind:toggle="onToggleFab" bind:expense="onFabExpense" bind:income="onFabIncome" bind:transfer="onFabTransfer" />
    <text class="status" wx:if="{{phase === 'ledger-loading'}}">正在读取流水</text>
    <block wx:elif="{{phase === 'ledger-error'}}">
      <text class="error">{{errorMessage}}</text>
      <button bindtap="onRetry">重新加载</button>
    </block>
    <block wx:elif="{{phase === 'ready'}}">
      <text class="error" wx:if="{{searchErrorMessage}}">{{searchErrorMessage}}</text>
      <button wx:if="{{searchErrorMessage}}" bindtap="onRetry">重新搜索</button>
      <text class="status" wx:if="{{searchLoading}}">正在搜索</text>
      <text class="locate-miss" wx:if="{{locateMiss}}">{{locateMiss}}</text>
      <text class="empty" wx:if="{{searchEmpty}}">没有匹配的交易</text>
      <text class="empty" wx:elif="{{empty}}">本月暂无记录</text>
      <block wx:for="{{groups}}" wx:key="key">
        <view class="day">
          <text>{{item.label}}</text>
          <text class="count">{{item.count}} 笔</text>
        </view>
        <view id="{{row.key}}" class="row {{row.kind}} {{highlightKey === row.key ? 'post-save-highlight' : ''}}" wx:for="{{item.rows}}" wx:for-item="row" wx:key="key" data-kind="{{row.kind}}" data-id="{{row.recordId}}" bindtap="onOpenRecord">
          <view class="row-main">
            <text class="row-title">{{row.title}}</text>
            <text class="row-detail" wx:if="{{row.detail}}">{{row.detail}}</text>
            <text class="row-time">{{row.timeLabel}}</text>
          </view>
          <text class="amount {{row.amountToneClass}}">{{row.amountLabel}}</text>
        </view>
      </block>
    </block>
  </block>
</view>
