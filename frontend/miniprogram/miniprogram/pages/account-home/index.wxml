<view class="page">
  <text class="status" wx:if="{{phase === 'account-loading'}}">正在读取账户</text>
  <block wx:elif="{{phase === 'account-error'}}">
    <text class="error">{{errorMessage}}</text>
    <button bindtap="onRetry">重新加载</button>
    <button bindtap="onBackToList">返回账本</button>
  </block>
  <block wx:else>
    <view class="nav">
      <text class="nav-link" bindtap="onBackToList">‹ 账本</text>
      <text class="nav-link" bindtap="onOpenSettings">账户设置</text>
    </view>
    <view class="asset">
      <text class="name">{{name}}</text>
      <text class="label">当前余额</text>
      <text class="balance {{balanceToneClass}}">{{balanceLabel}}</text>
      <text class="hint" wx:if="{{archiveHint}}">{{archiveHint}}</text>
    </view>
    <view class="filter">
      <text class="month-label">{{monthLabel}}</text>
      <text class="filter-action" bindtap="onChooseAll">全部时间</text>
      <text class="filter-action" bindtap="onChooseMonth">月份</text>
      <text class="filter-action" bindtap="onChooseRange">自定义</text>
    </view>
    <view class="month" wx:if="{{filterMode === 'month'}}">
      <text class="month-step" bindtap="onPreviousMonth">‹</text>
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-step" bindtap="onNextMonth">›</text>
    </view>
    <view class="range" wx:if="{{filterMode === 'range' || choosingRange}}">
      <picker mode="date" value="{{rangeFrom}}" bindchange="onRangeFrom">
        <text class="filter-action">{{rangeFrom || '开始日期'}}</text>
      </picker>
      <text>至</text>
      <picker mode="date" value="{{rangeTo}}" bindchange="onRangeTo">
        <text class="filter-action">{{rangeTo || '结束日期'}}</text>
      </picker>
    </view>
    <text class="error" wx:if="{{rangeError}}">{{rangeError}}</text>
    <view class="summary" wx:if="{{phase === 'ready' && showMonthSummary}}">
      <view class="summary-item">
        <text class="label">收入</text>
        <text class="figure {{incomeToneClass}}">{{incomeLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">支出</text>
        <text class="figure {{expenseToneClass}}">{{expenseLabel}}</text>
      </view>
      <view class="summary-item">
        <text class="label">{{monthCloseCaption || '结余'}}</text>
        <text class="figure {{monthCloseLabel ? monthCloseTone : surplusToneClass}}">{{monthCloseLabel || surplusLabel}}</text>
      </view>
    </view>
    <input class="search" value="{{searchInput}}" placeholder="搜索名称" bindinput="onSearchInput" confirm-type="search" />
    <entry-fab wx:if="{{!archived && phase !== 'account-loading' && phase !== 'account-error'}}" show-adjust="{{true}}" open="{{fabOpen}}" bind:toggle="onToggleFab" bind:expense="onFabExpense" bind:income="onFabIncome" bind:transfer="onFabTransfer" bind:adjust="onFabAdjust" />
    <text class="status" wx:if="{{phase === 'ledger-loading'}}">正在读取流水</text>
    <block wx:elif="{{phase === 'ledger-error'}}">
      <text class="error">{{errorMessage}}</text>
      <button bindtap="onRetry">重新加载</button>
    </block>
    <block wx:elif="{{phase === 'ready'}}">
      <text class="error" wx:if="{{searchErrorMessage}}">{{searchErrorMessage}}</text>
      <button wx:if="{{searchErrorMessage}}" bindtap="onRetry">重新搜索</button>
      <text class="status" wx:if="{{searchLoading}}">正在搜索</text>
      <text class="locate-miss" wx:if="{{locateMiss}}">{{locateMiss}}</text>
      <text class="empty" wx:if="{{searchEmpty}}">没有匹配的交易</text>
      <text class="empty" wx:elif="{{empty}}">{{emptyText}}</text>
      <block wx:for="{{groups}}" wx:key="key">
        <text class="month-heading" wx:if="{{item.monthHeading}}">{{item.monthHeading}}</text>
        <view class="day">
          <text>{{item.label}}</text>
          <text class="count">{{item.count}} 笔</text>
        </view>
        <view id="{{row.key}}" class="row {{row.kind}} {{highlightKey === row.key ? 'post-save-highlight' : ''}}" wx:for="{{item.rows}}" wx:for-item="row" wx:key="key" data-kind="{{row.kind}}" data-id="{{row.recordId}}" data-day="{{row.dayKey}}" bindtap="onOpenRecord">
          <view class="row-main">
            <text class="row-title">{{row.title}}</text>
            <text class="row-detail" wx:if="{{row.detail}}">{{row.detail}}</text>
            <text class="row-time">{{row.timeLabel}}</text>
          </view>
          <text class="amount {{row.amountToneClass}}">{{row.amountLabel}}</text>
        </view>
      </block>
      <block wx:if="{{phase === 'ready'}}">
        <text class="status" wx:if="{{loadingMore}}">正在加载</text>
        <block wx:elif="{{moreError}}">
          <text class="error">{{moreError}}</text>
          <button bindtap="onRetryMore">重试</button>
        </block>
        <text class="status" wx:elif="{{reachedEnd && !empty}}">已加载全部记录</text>
      </block>
    </block>
  </block>
</view>
