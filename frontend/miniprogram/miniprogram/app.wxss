page {
  background: #f6f6f6;
  color: #1a1a1a;
  font-size: 32rpx;
  line-height: 1.5;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.fab-menu,
.fab-button,
.fab-account {
  background: #111111;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.fab-menu {
  display: flex;
  gap: 12rpx;
}

.fab-accounts {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 12rpx;
}
