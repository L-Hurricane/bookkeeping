.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.fab-sheet {
  min-width: 196rpx;
  padding: 8rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 26, 26, 0.12);
}

.fab-action {
  display: block;
  padding: 22rpx 36rpx;
  color: #1a1a1a;
  font-size: 30rpx;
}

.above-tab {
  bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.fab-button {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #1f4b73;
  color: #ffffff;
  font-size: 48rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(31, 75, 115, 0.28);
}
